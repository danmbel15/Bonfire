# Bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN="<TOKEN>"

# uri for the Lavalink Container (address:port)
LAVALINK_URI="http://audio:2333"

# password for the Lavalink server
LAVALINK_PASS="<PASSWORD>"

# port for the Lavalink server // Default is 2333
LAVALINK_PORT=<PORT>

# Internal address for the Lavalink server !! Different from container!! // Default is: 0.0.0.0
LAVALINK_ADDRESS="<ADDRESS>"

# Path where uploaded files will be saved into for playback
MUSIC_PATH="/music"